# AdaptiveShield Email OTP Authentication Environment Config
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=adaptiveshield_super_secure_jwt_token_secret_key_2026

# ==========================================
# Real Gmail SMTP Configuration
# ==========================================
# 1. EMAIL_USER: Your full Gmail address (e.g., yourname@gmail.com)
# 2. EMAIL_PASS: 16-character Google App Password (NOT your normal Google password)
# (Generated via: Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_USER=
EMAIL_PASS=

# Optional custom sender label (defaults to "AdaptiveShield Security" <EMAIL_USER>)
EMAIL_FROM=

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
