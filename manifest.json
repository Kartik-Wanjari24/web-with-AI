{
  "manifest_version": 3,
  "name": "AdaptiveShield — Real-Time Web Guard",
  "short_name": "AdaptiveShield",
  "version": "2.0.0",
  "description": "Monitors live web browsing, blocks phishing domains, and shows on-screen security alerts with plain-English threat explanations.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "webNavigation",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js":  ["contentScript.js"],
      "css": ["alert.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AdaptiveShield — Click to open security dashboard"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches":   ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
